{
  "version": 2,
  "builds": [
    {
      "src": "api/ws.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/ws.js"
    },
    {
      "src": "/controller",
      "dest": "/public/controller.html"
    },
    {
      "src": "/",
      "dest": "/public/scoreboard.html"
    }
  ]
}